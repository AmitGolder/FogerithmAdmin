{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "fogerithm-admin": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/fogerithm-admin",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"]
          },
          "configurations": { "production": { "optimization": true, "outputHashing": "all" } },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": { "production": { "buildTarget": "fogerithm-admin:build:production" }, "development": { "buildTarget": "fogerithm-admin:build" } },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "93ded714-8b2e-43f2-9ee4-b4dc38f6af2d"
  }
}
